# UniFi x flinchbot settings.
# You normally DON'T edit this by hand: the app's first-run screen and the
# Settings (gear) button create and update a file called .env for you.
# This example just documents what can go in it.

# Which AI answers: "anthropic" (Claude) or "openai" (ChatGPT / GPT models).
# You can save keys for both and switch in Settings.
AI_PROVIDER=anthropic

# Claude: API key from console.anthropic.com -> API Keys, and the model to use.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# ChatGPT: API key from platform.openai.com -> API keys, and the model to use.
# (A ChatGPT Plus/Pro subscription does NOT include API usage - add API credit.)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol

# Web address the app listens on. 127.0.0.1 = only this PC (recommended).
# Set to 0.0.0.0 ONLY if you understand that anyone on the network can then
# open the app.
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

# Safety cap on how many tool-call rounds the AI may make for one question.
MAX_TOOL_ROUNDS=15

# Longest single reply the AI may write, in tokens (about 0.75 words each).
# The model's built-in reasoning counts toward this too. Max 21000.
MAX_OUTPUT_TOKENS=16000

# Extra host names allowed in the browser address bar (comma separated).
# Only needed if you open the app by a name other than localhost / an IP.
# ALLOWED_HOSTS=
