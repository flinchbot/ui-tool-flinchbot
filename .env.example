# UniFi x Claude settings.
# You normally DON'T edit this by hand: the app's first-run screen and the
# Settings (gear) button create and update a file called .env for you.
# This example just documents what can go in it.

# Your Anthropic API key (console.anthropic.com -> API Keys).
ANTHROPIC_API_KEY=

# Which Claude model answers questions. "Test key & load models" in Settings
# lists the ones your key can use.
CLAUDE_MODEL=claude-sonnet-5-5

# Web address the app listens on. 127.0.0.1 = only this PC (recommended).
# Set to 0.0.0.0 ONLY if you understand that anyone on the network can then
# open the app.
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

# Safety cap on how many tool-call rounds Claude may make for one question.
MAX_TOOL_ROUNDS=15

# Extra host names allowed in the browser address bar (comma separated).
# Only needed if you open the app by a name other than localhost / an IP.
# ALLOWED_HOSTS=
